          "cookies": [],
          "content": {
            "size": 28106,
            "mimeType": "application/json",
            "text": "[{\"type\":\"feature\",\"title\":\"Google Gemini 3.7 Flash now available in AI Gateway and Agent Runners\",\"link\":\"https://www.netlify.com/changelog/gemini-3-7-flash-ai-gateway-agent-runners/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-08-13T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Manage your team invitations from your Netlify dashboard\",\"link\":\"https://www.netlify.com/changelog/2026-08-12-accept-team-invites-in-app/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-08-12T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Pay for Netlify with Apple Pay and Google Pay\",\"link\":\"https://www.netlify.com/changelog/2026-08-12-apple-pay-google-pay/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-08-12T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Simplified single sign-on (SSO) process\",\"link\":\"https://www.netlify.com/changelog/2026-08-12-sso-sign-in-with-email/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-08-12T00:00:00.000Z\"},{\"type\":\"announcement\",\"title\":\"Open models are having a moment. We’re all in.\",\"body\":\"Netlify now gives every customer access to leading open and commercial AI models through Agent Runners and AI Gateway, making it easy to build, experiment, and ship on production infrastructure.\",\"link\":\"https://www.netlify.com/blog/build-with-open-models-in-production/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-08-06T17:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"SolidStart 2 just works on Netlify\",\"link\":\"https://www.netlify.com/changelog/2026-08-06-solidstart-2-on-netlify/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-08-06T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"AI Gateway adds OpenRouter support for more AI model choice\",\"link\":\"https://www.netlify.com/changelog/2026-08-06-ai-gateway-openrouter/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-08-06T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Agent Runners adds OpenCode and AI model controls\",\"link\":\"https://www.netlify.com/changelog/2026-08-06-opencode-agent-runners/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-08-06T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Ask mode for Agent Runners\",\"link\":\"https://www.netlify.com/changelog/2026-07-30-agent-runners-ask-mode/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-07-30T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"GPT-5.6 Luna and Terra price reduction on AI Gateway\",\"link\":\"https://www.netlify.com/changelog/gpt-5-6-luna-terra-price-reduction-ai-gateway/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-07-30T00:00:00.000Z\"},{\"type\":\"announcement\",\"title\":\"New Netlify projects are now private by default\",\"body\":\"Sites & apps on Netlify now start private. You can build, deploy, and preview as usual, but nothing is publicly accessible until you decide to make it public.\",\"link\":\"https://www.netlify.com/blog/new-netlify-projects-are-now-private-by-default/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-07-28T15:40:46.753Z\"},{\"type\":\"feature\",\"title\":\"Keep projects private by default with project visibility\",\"link\":\"https://www.netlify.com/changelog/2026-07-28-start-with-private-project-urls/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-07-28T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Security Update: Multiple vulnerabilities in Nuxt\",\"link\":\"https://www.netlify.com/changelog/2026-07-27-nuxt-security-vulnerabilities/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-07-27T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Netlify Drop updates\",\"link\":\"https://www.netlify.com/changelog/2026-07-27-netlify-drop-refresh/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-07-27T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Claude Opus 5 Now Available in AI Gateway and Agent Runners\",\"link\":\"https://www.netlify.com/changelog/claude-opus-5-ai-gateway-agent-runners/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-07-24T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Security Update: Multiple vulnerabilities in React Router\",\"link\":\"https://www.netlify.com/changelog/2026-07-23-react-router-security-vulnerabilities/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-07-23T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Security Update: Multiple vulnerabilities in Next.js\",\"link\":\"https://www.netlify.com/changelog/2026-07-21-nextjs-security-vulnerabilities/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-07-21T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Google Gemini 3.6 Flash and Gemini 3.5 Flash-Lite Now Available in AI Gateway and Agent Runners\",\"link\":\"https://www.netlify.com/changelog/gemini-3-6-flash-3-5-flash-lite-ai-gateway-agent-runners/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-07-21T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Invite Developers and Internal Builders without assigning a project\",\"link\":\"https://www.netlify.com/changelog/2026-07-20-invite-builders-without-project-access/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-07-20T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Set AI usage limits for individual team members\",\"link\":\"https://www.netlify.com/changelog/2026-07-15-per-member-ai-usage-limits/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-07-15T00:00:00.000Z\"},{\"type\":\"announcement\",\"title\":\"More headroom, a lower per-credit rate, and a bill you can predict: introducing new Pro plan tiers\",\"body\":\"New Netlify Pro tiers offer up to 20,000 monthly credits, credit rollovers, and predictable pricing for growing teams.\",\"link\":\"https://www.netlify.com/blog/new-pro-plan-tiers/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-07-14T20:41:00.000Z\"},{\"type\":\"feature\",\"title\":\"Introducing Pro plan monthly credit tiers with rollovers\",\"link\":\"https://www.netlify.com/changelog/2026-07-14-pro-plan-credit-tiers/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-07-14T00:00:00.000Z\"},{\"type\":\"announcement\",\"title\":\"Netlify inside of Claude Design\",\"body\":\"Netlify and Anthropic have partnered to let you deploy directly to Netlify right inside Claude Design. No manual exports, no re-uploading. Design, deploy, and iterate all in one flow.\\n\",\"link\":\"https://www.netlify.com/blog/netlify-inside-of-claude-design/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-07-13T17:52:14.622Z\"},{\"type\":\"feature\",\"title\":\"OpenAI GPT-5.6 Sol, Luna, and Terra Now Available in AI Gateway and Agent Runners\",\"link\":\"https://www.netlify.com/changelog/gpt-5-6-sol-luna-terra-ai-gateway-agent-runners/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-07-09T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Node.js 24 is now the default for Builds and Functions on new sites\",\"link\":\"https://www.netlify.com/changelog/2026-07-07-nodejs-24-default-new-sites/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-07-07T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Claude Fable 5 reactivated in AI Gateway\",\"link\":\"https://www.netlify.com/changelog/claude-fable-5-re-enabled/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-07-01T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Claude Sonnet 5 now available in AI Gateway and Agent Runners\",\"link\":\"https://www.netlify.com/changelog/claude-sonnet-5-ai-gateway-agent-runners/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-06-30T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Nano Banana 2 Lite (Gemini 3.1 Flash-Lite Image) is now available in AI Gateway.\",\"link\":\"https://www.netlify.com/changelog/gemini-3-1-flash-lite-image-ai-gateway/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-06-30T00:00:00.000Z\"},{\"type\":\"announcement\",\"title\":\"Netlify Functions, designed for Agent Experience\",\"body\":\"Netlify Functions update focused on Agent Experience, making them more discoverable, configurable, and interoperable with the modern JavaScript ecosystem.\",\"link\":\"https://www.netlify.com/blog/netlify-functions-designed-for-agent-experience/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-06-25T13:57:42.909Z\"},{\"type\":\"feature\",\"title\":\"Functions redesigned for agents\",\"link\":\"https://www.netlify.com/changelog/2026-06-25-functions-redesigned-for-agents/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-06-25T00:00:00.000Z\"},{\"type\":\"announcement\",\"title\":\"How we measure Netlify’s Agent Experience\",\"body\":\"We built AXIS, an open source scoring framework for agent experience, and ran it on our own platform first. Here’s what the data showed and what we changed.\",\"link\":\"https://www.netlify.com/blog/how-we-measure-netlify-agent-experience/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-06-24T22:26:00.000Z\"},{\"type\":\"feature\",\"title\":\"Astro 7 just works on Netlify\",\"link\":\"https://www.netlify.com/changelog/2026-06-22-astro-7/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-06-22T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Preview data changes in Netlify Database\",\"link\":\"https://www.netlify.com/changelog/2026-06-22-preview-data-changes-netlify-database/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-06-22T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"SAML provisioning upgrades for assigning default roles\",\"link\":\"https://www.netlify.com/changelog/2026-06-22-saml-provisioning-role-options/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-06-22T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"React Router 8 is now supported on Netlify\",\"link\":\"https://www.netlify.com/changelog/2026-06-18-react-router-8-support/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-06-18T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Project labels are now available on Pro\",\"link\":\"https://www.netlify.com/changelog/2026-06-12-project-labels-on-pro/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-06-12T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Environment variable size limit removed for Serverless Functions\",\"link\":\"https://www.netlify.com/changelog/2026-06-12-serverless-functions-env-var-size-limit-removed/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-06-12T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Netlify is now in the Cursor marketplace\",\"link\":\"https://www.netlify.com/changelog/2026-06-09-netlify-cursor-marketplace/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-06-09T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Claude Fable 5 now available in AI Gateway\",\"link\":\"https://www.netlify.com/changelog/claude-fable-5-ai-gateway/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-06-09T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Angular v22 is now supported\",\"link\":\"https://www.netlify.com/changelog/2026-06-01-support-for-angular-v22/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-06-03T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Security update: multiple vulnerabilities in React Router\",\"link\":\"https://www.netlify.com/changelog/2026-06-02-react-router-security-vulnerabilities/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-06-02T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Claude Opus 4.8 now available in AI Gateway and Agent Runners\",\"link\":\"https://www.netlify.com/changelog/claude-opus-4-8-ai-gateway-agent-runners/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-05-28T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Build Plugins: End of support for Node.js 18 + Node.js 20\",\"body\":\"Check out the forums to learn more.\",\"link\":\"https://answers.netlify.com/t/build-plugins-end-of-support-for-node-js-18-node-js-20/\",\"link_text\":\"Read the forums post\",\"updated_at\":\"2026-05-21T16:46:36.835Z\"},{\"type\":\"feature\",\"title\":\"Build Plugins: End of support for Node.js 18 + Node.js 20\",\"link\":\"https://answers.netlify.com/t/build-plugins-end-of-support-for-node-js-18-node-js-20/162662\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-05-21T16:46:36.000Z\"},{\"type\":\"feature\",\"title\":\"Gemini 3.5 Flash now available in Agent Runners\",\"link\":\"https://www.netlify.com/changelog/gemini-3-5-flash-agent-runners/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-05-20T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Security update: multiple vulnerabilities in Nuxt\",\"link\":\"https://www.netlify.com/changelog/2026-05-19-nuxt-security-vulnerabilities/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-05-19T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Gemini 3.5 Flash now available in AI Gateway\",\"link\":\"https://www.netlify.com/changelog/gemini-3-5-flash-ai-gateway/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-05-19T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Agent Runners workflow improvements\",\"link\":\"https://www.netlify.com/changelog/2026-05-13-agent-runners-workflow-improvements/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-05-13T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Block project transfers out of your team\",\"link\":\"https://www.netlify.com/changelog/2026-05-08-block-project-transfers/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-05-08T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Security Update: Multiple vulnerabilities in Next.js and React\",\"link\":\"https://www.netlify.com/changelog/2026-05-08-react-nextjs-security-vulnerabilities/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-05-08T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Gemini 3.1 Flash-Lite now available in AI Gateway\",\"link\":\"https://www.netlify.com/changelog/gemini-3-1-flash-lite-ai-gateway/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-05-07T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"OpenAI GPT-5.5 Instant now available in AI Gateway\",\"link\":\"https://www.netlify.com/changelog/2026-05-05-gpt-5-5-instant-ai-gateway/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-05-05T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Netlify Identity package update: CSRF protection with new `verifyRequestOrigin` helper\",\"link\":\"https://www.netlify.com/changelog/2026-05-02-netlify-identity-verify-request-origin/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-05-02T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"New `netlify logs` CLI command\",\"link\":\"https://www.netlify.com/changelog/2026-05-01-netlify-logs-cli-command/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-05-01T00:00:00.000Z\"},{\"type\":\"announcement\",\"title\":\"Netlify + Stripe\",\"body\":\"The Netlify integration for Stripe Projects lets developers and coding agents create or link a Netlify account, provision a new site, and deploy from the same terminal workflow used to set up the rest of their app.\",\"link\":\"https://www.netlify.com/blog/netlify-available-in-stripe-projects/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-04-29T16:02:17.768Z\"},{\"type\":\"feature\",\"title\":\"Deploy to Netlify with Stripe Projects\",\"link\":\"https://www.netlify.com/changelog/2026-04-29-stripe-projects/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-04-29T00:00:00.000Z\"},{\"type\":\"announcement\",\"title\":\"Netlify Database is now available: from provisioning to integrated Postgres\",\"body\":\"Netlify Database is a fully managed Postgres database built into the Netlify platform. It brings professional branching and migration workflows into every project, so builders can move fast without things constantly breaking. \",\"link\":\"https://www.netlify.com/blog/netlify-database/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-04-28T17:05:36.427Z\"},{\"type\":\"feature\",\"title\":\"Netlify Database is now generally available\",\"link\":\"https://www.netlify.com/changelog/2026-04-28-netlify-database/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-04-28T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"OpenAI GPT-5.5 and GPT-5.5 Pro now available in AI Gateway and Agent Runners\",\"link\":\"https://www.netlify.com/changelog/gpt-5-5-ai-gateway-agent-runners/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-04-24T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Rename an agent run\",\"link\":\"https://www.netlify.com/changelog/2026-04-23-rename-agent-run/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-04-23T00:00:00.000Z\"},{\"type\":\"announcement\",\"title\":\"Netlify for Agents\",\"body\":\"Today we are launching our first website that is built for agents, not for humans.\",\"link\":\"https://www.netlify.com/blog/netlify-for-agents/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-04-22T16:29:56.517Z\"},{\"type\":\"feature\",\"title\":\"GPT Image 2 now available in AI Gateway\",\"link\":\"https://www.netlify.com/changelog/gpt-image-2-ai-gateway/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-04-21T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"New frontend-design skill for Agent Runners\",\"link\":\"https://www.netlify.com/changelog/2026-04-17-frontend-design-skill-for-agent-runners/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-04-17T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Claude Opus 4.7 now available in AI Gateway and Agent Runners\",\"link\":\"https://www.netlify.com/changelog/claude-opus-4-7-ai-gateway-agent-runners/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-04-16T00:00:00.000Z\"},{\"type\":\"announcement\",\"title\":\"The end of seats: pricing Netlify for 3 billion builders\",\"body\":\"Unlimited seats on Netlify Pro (including Git contributors)\",\"link\":\"https://www.netlify.com/blog/pricing-netlify-for-3-billion-builders/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-04-14T15:45:06.115Z\"},{\"type\":\"feature\",\"title\":\"New sorting and filter controls on the Members page\",\"link\":\"https://www.netlify.com/changelog/2026-04-14-members-page-sorting-filter-controls/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-04-14T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Free unlimited seats on Pro, unlimited form submissions, &amp; updated credit rates\",\"link\":\"https://www.netlify.com/changelog/2026-04-14-pricing-updates-april-2026/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-04-14T00:00:00.000Z\"},{\"type\":\"announcement\",\"title\":\"Your code, your choice: Netlify’s stance on AI training data\",\"body\":\"At Netlify, we think the principle here is simple: your work belongs to you, and no one should train on it without your say-so.\",\"link\":\"https://www.netlify.com/blog/stance-on-ai-training-data/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-04-13T15:14:02.749Z\"},{\"type\":\"feature\",\"title\":\"Netlify Database GA coming soon, no new databases for now\",\"link\":\"https://www.netlify.com/changelog/2026-04-13-netlify-db-ga-coming-soon/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-04-13T00:00:00.000Z\"},{\"type\":\"announcement\",\"title\":\"You own your content\",\"body\":\"Netlify reaffirms its commitment to developers: you own your content. Learn how we protect your data, avoid selling your code, and ensure AI training only happens with your explicit consent.\",\"link\":\"https://www.netlify.com/blog/you-own-your-content/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-04-10T21:55:00.000Z\"},{\"type\":\"announcement\",\"title\":\"Your builds just got faster. Here’s how.\",\"body\":\"Netlify has rebuilt its entire build infrastructure from the ground up. We have replaced our Kubernetes-based system with Firecracker MicroVMs. This new infrastructure is more than a speed boost; it’s a more secure, scalable foundation for the future of web development. It’s already handling your production traffic today at the same pricing and with zero work required on your end.\",\"link\":\"https://www.netlify.com/blog/your-builds-just-got-faster/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-04-09T16:35:33.787Z\"},{\"type\":\"feature\",\"title\":\"Security Update: DoS vulnerability in Next.js and React Server Components\",\"link\":\"https://www.netlify.com/changelog/2026-04-08-react-nextjs-dos-vulnerability/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-04-08T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Deploy logs streaming is now faster\",\"link\":\"https://www.netlify.com/changelog/2026-04-06-deploy-logs-streaming-is-now-faster/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-04-06T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Netlify CLI adds prompt-based creation and anonymous deploys\",\"link\":\"https://www.netlify.com/changelog/2026-03-27-create-and-deploy-anything-netlify-clis-improved-ax/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-03-31T00:00:00.000Z\"},{\"type\":\"announcement\",\"title\":\"Better agent runs with prompt templates & skills\",\"body\":\"Learn how Netlify prompt templates and Skills help you move from idea to deployed site with consistent results. Discover how to reuse workflows, improve output quality, and ship faster with Agent Runners and Netlify.new.\",\"link\":\"https://www.netlify.com/blog/better-agent-runs-with-prompt-templates-and-skills/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-03-30T19:01:00.000Z\"},{\"type\":\"feature\",\"title\":\"Deploy from Codex with the Netlify Plugin\",\"link\":\"https://www.netlify.com/changelog/2026-03-27-deploy-from-codex-netlify-plugin/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-03-27T00:00:00.000Z\"},{\"type\":\"announcement\",\"title\":\"The Next.js adapter API just shipped, here’s what’s next\",\"body\":\"The Next.js Deployment Adapter API has shipped, after a year of collaboration with Netlify and OpenNext. Read about the continued work ahead and the future of OpenNext.\",\"link\":\"https://www.netlify.com/blog/the-next-js-adapter-api-just-shipped-here-s-what-comes-next/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-03-26T15:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Hydrogen with React Router 7 now supported on Netlify\",\"link\":\"https://www.netlify.com/changelog/2026-03-24-hydrogen-react-router-7/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-03-24T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Monitor credit usage by day\",\"link\":\"https://www.netlify.com/changelog/2026-03-24-monitor-credit-usage-by-day/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-03-24T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Invoices for Enterprise Available on the Billing Page\",\"link\":\"https://www.netlify.com/changelog/2026-03-20-invoices-for-enterprise-available-on-billing-page/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-03-20T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Start a Netlify project from a prompt\",\"body\":\"Build and ship web apps faster with AI and Netlify. Start with a prompt, use production infrastructure, and grow without rebuilding.\",\"link\":\"https://www.netlify.com/blog/start-a-netlify-project-from-a-prompt/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-03-18T16:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Start Netlify projects from a prompt\",\"link\":\"https://www.netlify.com/blog/start-a-netlify-project-from-a-prompt/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-03-18T16:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Introducing Prompt Templates\",\"link\":\"https://www.netlify.com/changelog/2026-03-18-prompt-templates/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-03-18T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"OpenAI GPT-5.4 Nano and GPT-5.4 Mini Now Available in AI Gateway\",\"link\":\"https://www.netlify.com/changelog/2026-03-17-gpt-5-4-nano-mini-ai-gateway/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-03-17T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"New Internal Builder role and granular project access controls\",\"link\":\"https://www.netlify.com/changelog/2026-03-16-internal-builder-role/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-03-16T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"See your available credits at a glance\",\"link\":\"https://www.netlify.com/changelog/2026-03-11-display-available-credits/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-03-12T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Astro 6 just works on Netlify\",\"link\":\"https://www.netlify.com/changelog/2026-03-10-astro-6/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-03-10T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Limit AI usage on your team\",\"link\":\"https://www.netlify.com/changelog/2026-03-06-limit-ai-feature-usage/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-03-06T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"OpenAI GPT-5.4 and GPT-5.4 Pro Now Available in AI Gateway and Agent Runners\",\"link\":\"https://www.netlify.com/changelog/gpt-5-4-ai-gateway-agent-runners/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-03-05T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Deploy Preview screenshots in agent runs\",\"link\":\"https://www.netlify.com/changelog/2026-03-03-agent-runs-deploy-preview-screenshot/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-03-03T23:59:59.000Z\"},{\"type\":\"announcement\",\"title\":\"Sponsoring npmx\",\"body\":\"It’s more important than ever that companies come together across competitive boundaries to sponsor and support the open ecosystem that lifts all boats.\",\"link\":\"https://www.netlify.com/blog/sponsoring-npmx/\",\"link_text\":\"Read the blog post\",\"updated_at\":\"2026-03-03T17:15:00.000Z\"},{\"type\":\"feature\",\"title\":\"Gemini 3.1 Flash-Lite Preview now available in AI Gateway\",\"link\":\"https://www.netlify.com/changelog/gemini-3-1-flash-lite-preview-ai-gateway/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-03-03T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"GPT-5.3 Instant now available in AI Gateway\",\"link\":\"https://www.netlify.com/changelog/gpt-5-3-instant-ai-gateway/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-03-03T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Use Netlify Agent Runners from Linear\",\"link\":\"https://www.netlify.com/changelog/2026-02-27-agent-runners-linear-integration/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-02-27T23:59:59.000Z\"},{\"type\":\"feature\",\"title\":\"Automatic PHP bot scan blocking now live on all plans\",\"link\":\"https://www.netlify.com/changelog/2026-02-27-php-scan-blocking/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-02-27T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Support for stale-while-revalidate in Cache API\",\"link\":\"https://www.netlify.com/changelog/cache-api-stale-while-revalidate/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-02-27T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Gemini 3.1 Flash Image Preview now available in AI Gateway\",\"link\":\"https://www.netlify.com/changelog/gemini-3-1-flash-image-preview-ai-gateway/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-02-26T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"GPT-5.3-Codex now available in AI Gateway\",\"link\":\"https://www.netlify.com/changelog/gpt-5-3-codex-ai-gateway/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-02-24T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Gemini 3.1 Pro Preview now available in AI Gateway\",\"link\":\"https://www.netlify.com/changelog/gemini-3-1-pro-preview-ai-gateway/\",\"link_text\":\"Read the changelog post to learn more\",\"updated_at\":\"2026-02-19T00:00:00.000Z\"},{\"type\":\"feature\",\"title\":\"Claude Sonnet 4.6 now available in AI Gateway and Agent Runners\",\"link\":\"h